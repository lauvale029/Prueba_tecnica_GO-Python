# Servidor
# ejemplo: 8080
PORT=
# ejemplo: development
ENV=
# puerto donde queda la documentación interactiva (Swagger UI). Opcional,
# por defecto 8081 si se deja vacío.
SWAGGER_PORT=

# Base de datos (Postgres)
# ejemplo: localhost
DB_HOST=
# ejemplo: 5432
DB_PORT=
# ejemplo: mova
DB_USER=
# ejemplo: mova
DB_PASSWORD=
# ejemplo: mova_payments
DB_NAME=
# ejemplo: disable
DB_SSLMODE=
# Construida a partir de las variables anteriores; usada directamente por la app.
# ejemplo: postgres://mova:mova@localhost:5432/mova_payments?sslmode=disable
DATABASE_URL=

# Redis (idempotencia + cache de resumen)
# ejemplo: localhost:6379
REDIS_ADDR=
# ejemplo: (vacío si Redis no tiene password)
REDIS_PASSWORD=
# ejemplo: 0
REDIS_DB=

# Autenticación (JWT)
# nunca uses este ejemplo como secreto real; genera uno con: openssl rand -base64 32
JWT_SECRET=
# ejemplo: 60
JWT_EXPIRATION_MINUTES=
# única credencial de servicio aceptada por /auth/login (no hay tabla de usuarios)
# ejemplo: mova-service
AUTH_USERNAME=
# ejemplo: (elige una contraseña propia)
AUTH_PASSWORD=

# Worker de conciliación (Python) — reutiliza AUTH_USERNAME/AUTH_PASSWORD
# de arriba, la misma credencial de servicio que usa la API.
# URL base de la API de Go tal como el worker debe verla (host, no el
# nombre de servicio de Docker). Ejemplo: http://localhost:8080
API_BASE_URL=
# minutos que debe estar PENDING un pago antes de rechazarlo. Opcional,
# por defecto 30 si se deja vacío.
RECONCILIATION_THRESHOLD_MINUTES=